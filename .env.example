# Copy to .env for local runs: cp .env.example .env

# Databricks auth for local development (profile-based, matches CLI/SDK resolution).
# Pick one of your `databricks auth profiles` entries.
DATABRICKS_CONFIG_PROFILE=
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com

# Serving endpoint backing the agent, reached through the Unity Gateway.
LLM_ENDPOINT_NAME=databricks-gpt-6-astra
