# Copy to .env for local runs: cp .env.example .env

# Databricks auth for local development (profile-based, matches CLI/SDK resolution).
# Pick one of your `databricks auth profiles` entries.
DATABRICKS_CONFIG_PROFILE=
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com

# Serving endpoint backing the agent, reached through the Unity Gateway.
LLM_ENDPOINT_NAME=databricks-gpt-6-astra

# Lakebase, holding conversation checkpoints and long-term memory. Bare names, not
# resource paths. Leave them blank to run without memory: the chat still works, the
# sidebar says so, and it forgets everything when the tab closes.
#
# Deploy the app before you run locally. The app's service principal has to create
# the schema below so that it owns it; if your own credentials get there first, the
# deployed app is locked out with "permission denied for schema".
LAKEBASE_AUTOSCALING_PROJECT=agent-genie-memory
LAKEBASE_AUTOSCALING_BRANCH=production
LAKEBASE_AGENT_MEMORY_SCHEMA=agent_memory

# Embeds stored memories so get_user_memory can search them by meaning.
DATABRICKS_EMBEDDING_ENDPOINT=databricks-gte-large-en

# MLflow tracing. Set MLFLOW_EXPERIMENT_NAME to a workspace path and every agent
# turn is logged there as a trace (model call, Genie tools, memory tools). The
# experiment is created on first run if it's missing. Leave it blank to run
# without tracing. Locally, traces go to the workspace of DATABRICKS_CONFIG_PROFILE.
# A UC trace location (below) can only bind to an experiment with no traces yet,
# so use a fresh experiment name when enabling UC storage.
MLFLOW_EXPERIMENT_NAME=/Shared/agent-genie-one-long-term-mem-traces
MLFLOW_TRACKING_URI=databricks

# Store trace spans in Unity Catalog Delta tables via a SQL warehouse instead of
# the default workspace-artifact storage. Needed on Databricks Apps runtimes that
# can't reach the artifact-storage host (spans fail to upload and traces show no
# spans). Set all three to enable it; clear any to fall back to the default store.
# The principal writing traces needs USE CATALOG + CREATE/MODIFY/SELECT on the
# schema and CAN_USE on the warehouse.
MLFLOW_TRACES_CATALOG=workshop_guy_catalog
MLFLOW_TRACES_SCHEMA=agent_genie_traces
MLFLOW_TRACES_TABLE_PREFIX=agent_chat
MLFLOW_TRACING_SQL_WAREHOUSE_ID=
